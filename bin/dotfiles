#!/bin/bash
set -e

DOTFILES_DIR="$HOME/.dotfiles"

# Install 1Password CLI if not present
if ! [ -x "$(command -v op)" ]; then
    echo "Installing 1Password CLI..."
    brew install 1password-cli
fi

# Verify 1Password is authenticated
if ! op whoami &>/dev/null; then
    echo "ERROR: 1Password CLI is not authenticated."
    echo ""
    echo "Before running this script:"
    echo "  1. Install 1Password from https://1password.com/downloads"
    echo "  2. Sign in to 1Password"
    echo "  3. Go to Settings > Developer > enable CLI integration"
    echo ""
    exit 1
fi

# Install homebrew
if ! [ -x "$(command -v brew)" ]; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Install git 
if ! [ -x "$(command -v git)" ]; then
    brew install git
fi

# Install pipx
if ! [ -x "$(command -v pipx)" ]; then
    brew install pipx
    pipx ensurepath
    sudo pipx ensurepath
fi

# Install ansible
if ! [ -x "$(command -v ansible)" ]; then
    pipx install --include-deps ansible
fi

# Install ansible-lint
if ! [ -x "$(command -v ansible-lint)" ]; then
    pipx install ansible-lint
fi

if ! [[ -d "$DOTFILES_DIR" ]]; then
    echo "Cloning repository"
    git clone --quiet https://github.com/dkanomad/dotfiles.git $DOTFILES_DIR
else
    echo "Updating repository"
    git -C $DOTFILES_DIR pull --quiet
fi

if [[ -f "$DOTFILES_DIR/requirements.yml" ]]; then
    cd "$DOTFILES_DIR"

    ansible-galaxy collection install -r requirements.yml --upgrade
fi

cd "$DOTFILES_DIR"

PROFILE="${1:-personal}"

ansible-playbook --diff -e "profile=${PROFILE}" "$DOTFILES_DIR/main.yml"