          "git stash drop*": "ask",
          "git stash clear*": "ask",
          "git reflog expire*": "ask",
          "git push --force*": "ask",
          "git push * --force*": "ask",
          "git push -f": "ask",
          "git push -f *": "ask",
          "git push * -f": "ask",
          "git push * -f *": "ask",
          "git push --delete*": "ask",
          "git push * --delete*": "ask",
          "git push * :*": "ask",
          "git worktree remove*": "ask",
          "git update-ref -d*": "ask",
          "git update-ref * -d*": "ask",

          "npm publish": "ask",
          "npm publish *": "ask",
          "pnpm publish": "ask",
          "pnpm publish *": "ask",

          "wrangler deploy": "ask",
          "wrangler deploy *": "ask",
          "terraform apply": "ask",
          "terraform apply *": "ask"
        },
        "external_directory": "ask",
        "doom_loop": "ask"
